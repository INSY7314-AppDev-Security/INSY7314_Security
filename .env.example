# Used by docker-compose.yml. Copy this file to .env (never commit .env).
JWT_SECRET=replace_with_a_long_random_string
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_strong_password
# The address the browser uses for the frontend (the API only accepts this origin)
CORS_ORIGIN=http://localhost:3000
# Optional cloud logging with Grafana Cloud Loki. Leave all three empty to log to files only
GRAFANA_LOKI_URL=
GRAFANA_LOKI_USER=
GRAFANA_LOKI_TOKEN=