{
  "id": "hustlehub-local-env",
  "name": "HustleHub Local",
  "values": [
    {
      "key": "host",
      "value": "${process.env.REACT_APP_API_URL}",
      "type": "default",
      "enabled": true
    },
    {
      "key": "adminEmail",
      "value": "admin@example.com",
      "type": "default",
      "enabled": true
    },
    {
      "key": "adminPassword",
      "value": "CHANGE_ME_to_your_ADMIN_PASSWORD",
      "type": "secret",
      "enabled": true
    }
  ],
  "_postman_variable_scope": "environment"
}