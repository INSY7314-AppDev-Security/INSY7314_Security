{
  "info": {
    "name": "HustleHub+ API - Part 3 Security Features",
    "description": "Comprehensive tests for Part 3 security features: CORS, request body size limit, account lockout (+ generic responses), and server-side session revocation (logout).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. CORS",
      "item": [
        {
          "name": "1.1 Allowed frontend origin gets the CORS header",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Access-Control-Allow-Origin is exactly the frontend origin', () => {",
                  "  pm.expect(pm.response.headers.get('Access-Control-Allow-Origin')).to.eql(pm.variables.get('allowedOrigin'));",
                  "});",
                  "pm.test('It is never a wildcard', () => pm.expect(pm.response.headers.get('Access-Control-Allow-Origin')).to.not.eql('*'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Origin",
                "value": "{{allowedOrigin}}"
              }
            ],
            "url": "{{apiHost}}/"
          }
        },
        {
          "name": "1.2 Unknown website gets no CORS header (browser will block it)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('The API still answers (CORS is enforced by the browser)', () => pm.response.to.have.status(200));",
                  "pm.test('No Access-Control-Allow-Origin header is sent', () => pm.expect(pm.response.headers.has('Access-Control-Allow-Origin')).to.be.false);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Origin",
                "value": "{{evilOrigin}}"
              }
            ],
            "url": "{{apiHost}}/"
          }
        },
        {
          "name": "1.3 Preflight from the allowed origin is accepted",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 204', () => pm.response.to.have.status(204));",
                  "pm.test('The allowed origin is returned', () => pm.expect(pm.response.headers.get('Access-Control-Allow-Origin')).to.eql(pm.variables.get('allowedOrigin')));",
                  "pm.test('POST is allowed', () => pm.expect(pm.response.headers.get('Access-Control-Allow-Methods')).to.include('POST'));",
                  "pm.test('The Authorization header is allowed', () => pm.expect(pm.response.headers.get('Access-Control-Allow-Headers').toLowerCase()).to.include('authorization'));"
                ]
              }
            }
          ],
          "request": {
            "method": "OPTIONS",
            "header": [
              {
                "key": "Origin",
                "value": "{{allowedOrigin}}"
              },
              {
                "key": "Access-Control-Request-Method",
                "value": "POST"
              },
              {
                "key": "Access-Control-Request-Headers",
                "value": "authorization,content-type"
              }
            ],
            "url": "{{apiHost}}/api/gigs"
          }
        },
        {
          "name": "1.4 Preflight from an unknown origin gets no CORS header",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('No Access-Control-Allow-Origin header is sent', () => pm.expect(pm.response.headers.has('Access-Control-Allow-Origin')).to.be.false);"
                ]
              }
            }
          ],
          "request": {
            "method": "OPTIONS",
            "header": [
              {
                "key": "Origin",
                "value": "{{evilOrigin}}"
              },
              {
                "key": "Access-Control-Request-Method",
                "value": "POST"
              }
            ],
            "url": "{{apiHost}}/api/gigs"
          }
        },
        {
          "name": "1.5 Requests without an Origin header (Postman, Newman, curl) still work",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{apiHost}}/"
          }
        }
      ]
    },
    {
      "name": "2. Request body size limit (10 kb)",
      "item": [
        {
          "name": "2.1 Body of about 20 kb is refused with 413",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.variables.set('bigBody', JSON.stringify({ email: 'big@example.com', password: 'x'.repeat(20000) }));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 413', () => pm.response.to.have.status(413));",
                  "pm.test('The message is safe and clear', () => pm.expect(pm.response.json().message).to.eql('Request body is too large'));",
                  "pm.test('No stack trace or file path is shown', () => pm.expect(pm.response.text()).to.not.match(/stack|node_modules|at .*\\.js/i));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{apiHost}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{{bigBody}}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "2.2 Normal small body is not refused for its size",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400 (validation), not 413', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{apiHost}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{ \"email\": \"small@example.com\" }",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "2.3 Broken JSON gives a clean 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400', () => pm.response.to.have.status(400));",
                  "pm.test('Message is controlled', () => pm.expect(pm.response.json().message).to.eql('Invalid JSON in request body'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{apiHost}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"oops\"",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "L. Account lockout",
      "item": [
        {
          "name": "L.1 Setup: register the lockout test user",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Lock Test\",\n  \"email\": \"lock_{{p3run}}@example.com\",\n  \"password\": \"Passw0rd123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('p3run', Date.now() + '' + Math.floor(Math.random()*1000));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "L.2 Wrong password, attempt 1 (401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"lock_{{p3run}}@example.com\",\n  \"password\": \"WrongPass1\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 401', () => pm.response.to.have.status(401));",
                  "pm.test('Generic message, no hint whether the email exists', () => pm.expect(pm.response.json().message).to.eql('Invalid email or password'));",
                  "pm.collectionVariables.set('genericMsg', pm.response.json().message);"
                ]
              }
            }
          ]
        },
        {
          "name": "L.3 Wrong password, attempt 2 (401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"lock_{{p3run}}@example.com\",\n  \"password\": \"WrongPass1\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 401', () => pm.response.to.have.status(401));",
                  "pm.test('Generic message, no hint whether the email exists', () => pm.expect(pm.response.json().message).to.eql('Invalid email or password'));"
                ]
              }
            }
          ]
        },
        {
          "name": "L.4 Wrong password, attempt 3 locks the account (still 401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"lock_{{p3run}}@example.com\",\n  \"password\": \"WrongPass1\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 401', () => pm.response.to.have.status(401));",
                  "pm.test('Generic message, no hint whether the email exists', () => pm.expect(pm.response.json().message).to.eql('Invalid email or password'));"
                ]
              }
            }
          ]
        },
        {
          "name": "L.5 CORRECT password while locked is refused (423)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"lock_{{p3run}}@example.com\",\n  \"password\": \"Passw0rd123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 423', () => pm.response.to.have.status(423));",
                  "const json = pm.response.json();",
                  "pm.test('Message says the account is locked', () => pm.expect(json.message).to.match(/locked/i));",
                  "pm.test('No token is issued while locked', () => pm.expect(json.token).to.be.undefined);"
                ]
              }
            }
          ]
        },
        {
          "name": "L.6 Wrong password while locked is also refused (423)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"lock_{{p3run}}@example.com\",\n  \"password\": \"WrongPass1\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 423', () => pm.response.to.have.status(423));"
                ]
              }
            }
          ]
        },
        {
          "name": "L.7 Unknown email gets the same generic 401 as a wrong password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"nobody_{{p3run}}@example.com\",\n  \"password\": \"WrongPass1\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 401', () => pm.response.to.have.status(401));",
                  "pm.test('Same message as a wrong password for a real account', () => pm.expect(pm.response.json().message).to.eql(pm.collectionVariables.get('genericMsg')));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "S. Session revocation (logout)",
      "item": [
        {
          "name": "S.1 Setup: register the revocation test user",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Session Test\",\n  \"email\": \"sess_{{p3run}}@example.com\",\n  \"password\": \"Passw0rd123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "S.2 Login on device 1",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"sess_{{p3run}}@example.com\",\n  \"password\": \"Passw0rd123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('sessToken1', pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "S.3 Login on device 2",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"sess_{{p3run}}@example.com\",\n  \"password\": \"Passw0rd123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('sessToken2', pm.response.json().token);",
                  "const part = pm.collectionVariables.get('sessToken2').split('.')[1].replace(/-/g,'+').replace(/_/g,'/');",
                  "const payload = JSON.parse(atob(part));",
                  "pm.test('Token carries a version number (tv)', () => pm.expect(payload.tv).to.be.a('number'));",
                  "pm.test('Token lifetime is 2 hours or less', () => pm.expect(payload.exp - payload.iat).to.be.at.most(7200));"
                ]
              }
            }
          ]
        },
        {
          "name": "S.4 Token 1 works before logout",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{sessToken1}}"
              }
            ],
            "url": "{{baseUrl}}/auth/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "S.5 Logout with token 1",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{sessToken1}}"
              }
            ],
            "url": "{{baseUrl}}/auth/logout"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "S.6 Token 1 is rejected after logout (401)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{sessToken1}}"
              }
            ],
            "url": "{{baseUrl}}/auth/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "S.7 Token 2 (other device) is ALSO rejected: logout cancels every session (401)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{sessToken2}}"
              }
            ],
            "url": "{{baseUrl}}/auth/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "S.8 Using the old token to log out again is rejected (401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{sessToken1}}"
              }
            ],
            "url": "{{baseUrl}}/auth/logout"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "S.9 Logout without a token is rejected (401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/logout"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "S.10 A fresh login after logout works",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"sess_{{p3run}}@example.com\",\n  \"password\": \"Passw0rd123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('sessToken3', pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "S.11 The fresh token works (401 only hits old tokens)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{sessToken3}}"
              }
            ],
            "url": "{{baseUrl}}/auth/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('Response does not leak stack traces or file paths', () => {",
          "  pm.expect(pm.response.text()).to.not.match(/node_modules|\\.js:\\d+:\\d+|\\bat \\w+(\\.\\w+)* \\(/);",
          "});"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "apiHost",
      "value": "https://localhost:5000"
    },
    {
      "key": "allowedOrigin",
      "value": "http://localhost:3000"
    },
    {
      "key": "evilOrigin",
      "value": "https://evil.example.com"
    },
    {
      "key": "host",
      "value": "https://localhost:5000"
    },
    {
      "key": "baseUrl",
