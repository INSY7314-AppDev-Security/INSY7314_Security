{
  "info": {
    "name": "HustleHub+ API - Part 3 Security Features",
    "description": "Tests for the Part 3 security features: account lockout (+ generic responses) and server-side session revocation (logout).\n\nREQUIRES the backend to be started with LOCKOUT_MAX_ATTEMPTS=3 and LOGIN_RATE_LIMIT_MAX=100 (see README). Run it as its own Newman step, separate from the Part 2 collection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "L. Account lockout",
      "item": [
        {
          "name": "L.1 Setup: register the lockout test user",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Lock Test\",\n  \"email\": \"lock_{{p3run}}@example.com\",\n  \"password\": \"Passw0rd123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('p3run', Date.now() + '' + Math.floor(Math.random()*1000));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "L.2 Wrong password, attempt 1 (401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"lock_{{p3run}}@example.com\",\n  \"password\": \"WrongPass1\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 401', () => pm.response.to.have.status(401));",
                  "pm.test('Generic message, no hint whether the email exists', () => pm.expect(pm.response.json().message).to.eql('Invalid email or password'));",
                  "pm.collectionVariables.set('genericMsg', pm.response.json().message);"
                ]
              }
            }
          ]
        },
        {
          "name": "L.3 Wrong password, attempt 2 (401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"lock_{{p3run}}@example.com\",\n  \"password\": \"WrongPass1\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 401', () => pm.response.to.have.status(401));",
                  "pm.test('Generic message, no hint whether the email exists', () => pm.expect(pm.response.json().message).to.eql('Invalid email or password'));"
                ]
              }
            }
          ]
        },
        {
          "name": "L.4 Wrong password, attempt 3 locks the account (still 401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"lock_{{p3run}}@example.com\",\n  \"password\": \"WrongPass1\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 401', () => pm.response.to.have.status(401));",
                  "pm.test('Generic message, no hint whether the email exists', () => pm.expect(pm.response.json().message).to.eql('Invalid email or password'));"
                ]
              }
            }
          ]
        },
        {
          "name": "L.5 CORRECT password while locked is refused (423)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"lock_{{p3run}}@example.com\",\n  \"password\": \"Passw0rd123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 423', () => pm.response.to.have.status(423));",
                  "const json = pm.response.json();",
                  "pm.test('Message says the account is locked', () => pm.expect(json.message).to.match(/locked/i));",
                  "pm.test('No token is issued while locked', () => pm.expect(json.token).to.be.undefined);"
                ]
              }
            }
          ]
        },
        {
          "name": "L.6 Wrong password while locked is also refused (423)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"lock_{{p3run}}@example.com\",\n  \"password\": \"WrongPass1\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 423', () => pm.response.to.have.status(423));"
                ]
              }
            }
          ]
        },
        {
          "name": "L.7 Unknown email gets the same generic 401 as a wrong password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"nobody_{{p3run}}@example.com\",\n  \"password\": \"WrongPass1\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 401', () => pm.response.to.have.status(401));",
                  "pm.test('Same message as a wrong password for a real account', () => pm.expect(pm.response.json().message).to.eql(pm.collectionVariables.get('genericMsg')));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "S. Session revocation (logout)",
      "item": [
        {
          "name": "S.1 Setup: register the revocation test user",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Session Test\",\n  \"email\": \"sess_{{p3run}}@example.com\",\n  \"password\": \"Passw0rd123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "S.2 Login on device 1",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"sess_{{p3run}}@example.com\",\n  \"password\": \"Passw0rd123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('sessToken1', pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "S.3 Login on device 2",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"sess_{{p3run}}@example.com\",\n  \"password\": \"Passw0rd123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('sessToken2', pm.response.json().token);",
                  "const part = pm.collectionVariables.get('sessToken2').split('.')[1].replace(/-/g,'+').replace(/_/g,'/');",
                  "const payload = JSON.parse(atob(part));",
                  "pm.test('Token carries a version number (tv)', () => pm.expect(payload.tv).to.be.a('number'));",
                  "pm.test('Token lifetime is 2 hours or less', () => pm.expect(payload.exp - payload.iat).to.be.at.most(7200));"
                ]
              }
            }
          ]
        },
        {
          "name": "S.4 Token 1 works before logout",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{sessToken1}}"
              }
            ],
            "url": "{{baseUrl}}/auth/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "S.5 Logout with token 1",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{sessToken1}}"
              }
            ],
            "url": "{{baseUrl}}/auth/logout"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "S.6 Token 1 is rejected after logout (401)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{sessToken1}}"
              }
            ],
            "url": "{{baseUrl}}/auth/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "S.7 Token 2 (other device) is ALSO rejected: logout cancels every session (401)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{sessToken2}}"
              }
            ],
            "url": "{{baseUrl}}/auth/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "S.8 Using the old token to log out again is rejected (401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{sessToken1}}"
              }
            ],
            "url": "{{baseUrl}}/auth/logout"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "S.9 Logout without a token is rejected (401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/logout"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "S.10 A fresh login after logout works",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"sess_{{p3run}}@example.com\",\n  \"password\": \"Passw0rd123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('sessToken3', pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "S.11 The fresh token works (401 only hits old tokens)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{sessToken3}}"
              }
            ],
            "url": "{{baseUrl}}/auth/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('Response does not leak stack traces or file paths', () => {",
          "  pm.expect(pm.response.text()).to.not.match(/node_modules|\\.js:\\d+:\\d+|\\bat \\w+(\\.\\w+)* \\(/);",
          "});"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "host",
      "value": "https://localhost:5000"
    },
    {
      "key": "baseUrl",
      "value": "{{host}}/api"
    }
  ]
}