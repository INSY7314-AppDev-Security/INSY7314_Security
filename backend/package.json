{
  "name": "hustlehub-plus-backend",
  "version": "1.0.0",
  "description": "Secure backend for HustleHub+ Part 1",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed:admin": "node src/seed/createAdmin.js",
    "test:api": "newman run postman/HustleHub-Part2.postman_collection.json -e postman/HustleHub.local.postman_environment.json --insecure",
    "test:api:report": "newman run postman/HustleHub-Part2.postman_collection.json -e postman/HustleHub.local.postman_environment.json --insecure -r cli,htmlextra --reporter-htmlextra-export ../docs/newman/newman-report.html",
    "test:checks": "node --test \"checks/*.check.js\"",
    "test": "jest --runInBand",
    "test:api:security": "newman run postman/HustleHub-Part3-Security.postman_collection.json -e postman/HustleHub.local.postman_environment.json --insecure",
    "test:api:part3": "newman run postman/HustleHub-Part3-Security.postman_collection.json -e postman/HustleHub.local.postman_environment.json --insecure --env-var host=https://localhost:5000"
  },
  "keywords": [],
  "author": "HustleHub+ Team",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.1",
    "selfsigned": "^5.5.0",
    "winston": "^3.19.0",
    "winston-loki": "^6.1.7"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "newman": "^6.2.3",
    "newman-reporter-htmlextra": "^1.23.1",
    "nodemon": "^3.1.14",
    "selfsigned": "^5.5.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  }
}