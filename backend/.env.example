PORT=5000
JWT_SECRET=replace_this_with_a_very_long_random_secret_key_here
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/hustlehub
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_strong_password

# Only this website may call the API from a browser. Use commas for more than one address
CORS_ORIGIN=http://localhost:3000

# Logging. LOG_LEVEL can be error, warn, info or debug. Logs go to backend/logs/
LOG_LEVEL=info
# Optional cloud logging with Grafana Cloud Loki. Leave all three empty to log to files only
GRAFANA_LOKI_URL=
GRAFANA_LOKI_USER=
GRAFANA_LOKI_TOKEN=
